{
  "pages": [
    
    
    "pages/index/index",
    "pages/search/search",
    "pages/video/video",
    "pages/login/login",
    "pages/personal/personal",
    "pages/aiai/aiai"
  ],
  "style": "v2",
  "sitemapLocation": "sitemap.json",
