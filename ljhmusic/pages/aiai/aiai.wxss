/* 让整个页面采用 flex 列布局 */
page {
  height: 100%;
  background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);
  color: #fff;
  display: flex;
  flex-direction: column;
}

/* 头部 */
.header {
  height: 180rpx;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
  flex-shrink: 0;
}

.robot-box {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  margin-right: 20rpx;
}

.robot {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 4rpx solid #00f0ff;
}

.wave {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: #00f0ff;
  opacity: .5;
  animation: wave 2s infinite;
}

@keyframes wave {
  0% {
    transform: translate(-50%, -50%) scale(1);
    opacity: .5;
  }

  100% {
    transform: translate(-50%, -50%) scale(2);
    opacity: 0;
  }
}

.title {
  font-size: 38rpx;
  font-weight: bold;
  background: linear-gradient(90deg, #00f0ff, #ff00ff);
  -webkit-background-clip: text;
  color: transparent;
}

/* 聊天区域：占满剩余空间，可滚动 */
.chat-area {
  flex: 1;
  padding: 0 30rpx;
  overflow: hidden;
}

.msg-wrap {
  display: flex;
  flex-direction: column;
}

.msg {
  margin: 20rpx 0;
  display: flex;
  align-items: flex-start;
}

.msg.user {
  justify-content: flex-end;
  flex-direction: row-reverse;
}

.name {
  font-size: 24rpx;
  margin: 0 15rpx;
  opacity: .6;
}

.bubble {
  max-width: 60%;
  padding: 18rpx 24rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  background: rgba(255, 255, 255, .08);
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(255, 255, 255, .2);
}

.msg.user .bubble {
  background: linear-gradient(135deg, #00f0ff, #ff00ff);
  color: #000;
}

.typing {
  position: relative;
  padding-right: 60rpx;
}

.typing::after {
  content: '';
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  background: #00f0ff;
  border-radius: 50%;
  right: 20rpx;
  animation: dot 1s infinite;
}

@keyframes dot {

  0%,
  100% {
    opacity: 0;
  }

  50% {
    opacity: 1;
  }
}

.slide-in {
  animation: slideIn .5s ease forwards;
}

@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 输入栏：固定底部 */
.input-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: rgba(0, 0, 0, .3);
  flex-shrink: 0;
}

input {
  flex: 1;
  height: 80rpx;
  background: rgba(255, 255, 255, .1);
  border-radius: 40rpx;
  padding: 0 30rpx;
  color: #fff;
  border: 1rpx solid rgba(255, 255, 255, .2);
}

.send-btn {
  margin-left: 20rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #833ab4, #fd1d1d, #fcb045);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 20rpx rgba(253, 29, 29, .6);
  transition: transform .2s;
}

.send-btn.active {
  transform: scale(1.1);
}

.btn-txt {
  color: #fff;
  font-size: 36rpx;
}