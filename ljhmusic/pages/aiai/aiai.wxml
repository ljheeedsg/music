<!-- pages/index/index.wxml -->
<view class="fireworks" wx:if="{{showWish}}">
  <view class="fw-text">祝老师同学们天天快乐！</view>
  <view class="particle" wx:for="{{particles}}" wx:key="*this" style="{{item}}"></view>
</view>

<view class="header">
  <view class="robot-box">
    <image class="robot" src="https://img.alicdn.com/imgextra/i3/O1CN01ZbM1XY1zZZj4A6wGf_!!6000000006728-0-tps-260-260.jpg"></image>
    <view class="wave"></view>
  </view>
  <text class="title">DeepSeek AI</text>
  <view class="mode-switch">
    <text class="mode-btn {{mode==='fast'?'active':''}}" bindtap="switchMode" data-mode="fast">极速模式</text>
    <text class="mode-btn {{mode==='reason'?'active':''}}" bindtap="switchMode" data-mode="reason">思考模式</text>
  </view>
  <view class="wish-btn" bindtap="startWish">🎉 祝福</view>
</view>

<!-- 原聊天区 -->
<scroll-view scroll-y scroll-top="{{scrollTop}}" class="chat-area">
  <view class="msg-wrap">
    <view wx:for="{{messages}}" wx:key="id" class="msg {{item.role}} slide-in">
      <text class="name">{{item.role=='user'?'我':'AI'}}</text>
      <text class="bubble">{{item.content}}</text>
    </view>
    <view wx:if="{{isTyping}}" class="msg ai slide-in">
      <text class="name">AI</text>
      <text class="bubble typing"></text>
    </view>
  </view>
</scroll-view>

<!-- 快捷键区域 -->
<view class="quick-keys">
  <view class="quick-key" wx:for="{{quickKeys}}" wx:key="id" bindtap="sendQuickKey" data-key="{{item}}">{{item}}</view>
</view>

<!-- 原输入栏 -->
<view class="input-bar">
  <input
    value="{{inputValue}}"
    bindinput="onInput"
    bindconfirm="sendMessage"
    confirm-type="send"
    placeholder="输入消息..."
    placeholder-style="color:#666"
  />
  <view class="send-btn {{inputValue?'active':''}}" bindtap="sendMessage">
    <text class="btn-txt">▶</text>
  </view>
</view>
