<!--pages/chat/chat.wxml-->
<view class="container">
  <!-- 顶部标题栏 -->
  <view class="header">
    <view class="title">AI智能助手</view>
    <view class="status">
      <view class="status-dot"></view>
      <text>在线</text>
    </view>
  </view>

  <!-- 聊天消息区域 -->
  <scroll-view class="chat-area" scroll-y scroll-with-animation scroll-top="{{scrollTop}}">
    <view class="messages">
      <block wx:for="{{messages}}" wx:key="id">
        <view class="message {{item.role === 'user' ? 'user-message' : 'ai-message'}}">
          <view class="avatar {{item.role === 'user' ? 'user-avatar' : 'ai-avatar'}}">
            <text>{{item.role === 'user' ? '我' : 'AI'}}</text>
          </view>
          <view class="bubble">
            <text>{{item.content}}</text>
          </view>
        </view>
      </block>
      
      <!-- AI正在输入指示器 -->
      <view class="typing-indicator" wx:if="{{isTyping}}">
        <view class="avatar ai-avatar">
          <text>AI</text>
        </view>
        <view class="bubble typing-bubble">
          <view class="typing-dots">
            <view class="dot"></view>
            <view class="dot"></view>
            <view class="dot"></view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 输入区域 -->
  <view class="input-area">
    <view class="input-container">
      <input 
        class="input" 
        placeholder="输入您的问题..." 
        bindinput="onInput" 
        value="{{inputValue}}"
        bindconfirm="sendMessage"
        focus="{{autoFocus}}"
      />
      <button class="send-btn" bindtap="sendMessage" disabled="{{!inputValue.trim()}}">
        <text class="send-icon">发送</text>
      </button>
    </view>
  </view>
</view>