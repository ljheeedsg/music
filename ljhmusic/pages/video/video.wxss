/* pages/video/video.wxss */
.videoContainer .header {
  display: flex;
  padding: 10rpx;
}
.videoContainer .header image{
  width: 60rpx;
  height: 60rpx;
}

.videoContainer .header .search {
  border: 1rpx solid #eee;
  /*flex-grow: 可拉伸 flex-shrink： 可压缩 flex-basis: 当前元素的宽度*/
  /*flex默认值: flex-grow: 0, flex-shrink: 1, flex-basis: auto*/
  /*flex:1  flex-grow: 1, flex-shrink: 1, flex-basis: 0%*/
  /*flex:auto  flex-grow: 1, flex-shrink: 1, flex-basis: auto*/
  /*flex: 1会导致父元素宽度自动为100%*/
  flex: 1;
  margin: 0 20rpx;
  font-size: 26rpx;
  text-align: center;
  line-height: 60rpx;
  color: #d43c33;
}

/* MV列表样式 */
.mv-list {
  padding: 20rpx;
}

.mv-item {
  margin-bottom: 30rpx;
  background: #fff;
  border-radius: 10rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.mv-cover-container {
  position: relative;
  width: 100%;
  height: 400rpx;
  overflow: hidden;
}

.mv-cover {
  width: 100%;
  height: 100%;
}

.play-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100rpx;
  height: 100rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
  color: #fff;
}

.mv-duration {
  position: absolute;
  bottom: 10rpx;
  right: 10rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  padding: 4rpx 10rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
}

.mv-info {
  padding: 20rpx;
}

.mv-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.mv-desc {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.singer {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.play-count {
  margin-left: 20rpx;
  flex-shrink: 0;
}

.source-song {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666;
  margin-top: 10rpx;
}

.source-song .tag {
  background: #d43c33;
  color: #fff;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
  margin-right: 10rpx;
  font-size: 22rpx;
}

.source-song .song-info {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mv-player-container {
  width: 100%;
  height: 400rpx;
  background: #000;
}

.mv-player {
  width: 100%;
  height: 100%;
}

/* 空状态提示样式 */
.empty-notice {
  padding: 100rpx 40rpx;
  text-align: center;
  background: #f8f8f8;
  margin: 40rpx 20rpx;
  border-radius: 10rpx;
}

.empty-notice .empty-text {
  display: block;
  font-size: 32rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.empty-notice .empty-desc {
  display: block;
  font-size: 28rpx;
  color: #ccc;
}


/* 搜索模式提示 */
.search-mode-tip {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #f5f5f5;
  font-size: 28rpx;
  color: #666;
}

.back-btn {
  color: #d43c33;
  font-size: 26rpx;
  padding: 10rpx 20rpx;
  border: 1rpx solid #d43c33;
  border-radius: 30rpx;
}

/* 搜索面板 */
.search-panel {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.search-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.search-content {
  position: relative;
  height: 100%;
  background: #fff;
  display: flex;
  flex-direction: column;
}

.search-header {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.search-input-box {
  flex: 1;
  position: relative;
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 15rpx 50rpx 15rpx 45rpx;
}

.search-input {
  font-size: 28rpx;
  color: #333;
}

.search-icon {
  position: absolute;
  left: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 32rpx;
  color: #999;
}

.cancel-btn {
  margin-left: 20rpx;
  font-size: 28rpx;
  color: #333;
  padding: 0 10rpx;
}

/* 快速搜索结果 */
.quick-results {
  flex: 1;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.result-title {
  padding: 30rpx 30rpx 20rpx;
  font-size: 28rpx;
  color: #999;
}

.result-list {
  flex: 1;
  padding: 0 20rpx;
}

.result-item {
  display: flex;
  align-items: center;
  padding: 20rpx 10rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.result-cover {
  width: 120rpx;
  height: 80rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
}

.result-info {
  flex: 1;
  overflow: hidden;
}

.result-name {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-singer {
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.play-tag {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(212, 60, 51, 0.1);
  border-radius: 50%;
  color: #d43c33;
  font-size: 32rpx;
}

/* 搜索提示 */
.search-tips {
  padding: 100rpx 40rpx;
  text-align: center;
}

.tip-text {
  display: block;
  font-size: 32rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.tip-desc {
  display: block;
  font-size: 26rpx;
  color: #ccc;
}

/* 默认占位 */
.search-placeholder {
  padding: 100rpx 40rpx;
  text-align: center;
}

.placeholder-icon {
  display: block;
  font-size: 100rpx;
  color: #ddd;
  margin-bottom: 30rpx;
}

.placeholder-text {
  display: block;
  font-size: 28rpx;
  color: #999;
  margin-bottom: 50rpx;
}

.example-keywords {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 20rpx;
}

.keyword-item {
  padding: 15rpx 30rpx;
  background: #f5f5f5;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #666;
}

/* 视频列表 */
.videoScroll {
  margin-top: 10rpx;
  /* calc: 可以动态计算css的宽高， 运算符左右两侧必须加空格，否则计算会失效 */
  /* 视口单位： vh vw  1vh = 1%的视口高度  1vw = 1%的视口宽度*/
  height: calc(100vh - 152rpx);
  /*height: calc(100vh - 100rpx); 用来测试页面上拉触底*/
}
.videoItem {
  padding: 0 3%;
}
/*.videoItem video {*/
  /*width: 100%;*/
  /*height: 360rpx;*/
  /*border-radius: 10rpx;*/
/*}*/

.videoItem .common {
  width: 100%;
  height: 360rpx;
  border-radius: 10rpx;
}




.videoItem .content {
  font-size: 26rpx;
  height:80rpx;
  line-height: 80rpx;
  max-width: 500rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* footer */
.footer {
  border-top: 1rpx solid #eee;
  padding: 20rpx 0;
}
.footer .avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  vertical-align: middle;
}

.footer  .nickName {
  font-size: 26rpx;
  vertical-align: middle;
  margin-left: 20rpx;
}

.footer .comments_praised {
  float: right;
}

.comments_praised .btn {
  display: inline;
  padding: 0;
  background-color: transparent;
  border-color: transparent;
}

.comments_praised .btn:after {
  border: none;
}

.comments_praised .item {
  margin-left: 50rpx;
  position: relative;
}

.comments_praised .item .count {
  position: absolute;
  top: -20rpx;
  font-size: 20rpx;
}







